# 复制为 .env 并填入真实 key。.env 已被 .gitignore 排除，绝不提交、不打印。
# 所有 key 都可留空：留空时 mock/dry-run/缓存命中路径照常工作。

# Tripo 建模（global 账号）。缓存命中时不消耗。
TRIPO_API_KEY=

# Runway Seedance 2.5（付费，480p $3.00 / 720p $4.50 每条 10 秒）
RUNWAYML_API_SECRET=

# LLM 后端（可插拔；在 config.yaml 里加新后端 + 这里加 key）
ASTRA_API_KEY=
DEEPSEEK_API_KEY=
