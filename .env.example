# Copy this file to .env and fill in the keys you need. .env is ignored by Git: never commit or print it.
# Every key may stay empty. The offline preset director, dry runs and the cached mesh work without any key.

# Video generation. config.yaml selects the service with video_backend (kling by default).
KLING_API_KEY=
# Runway Seedance 2.5 (paid: about USD 3.00 at 480p and USD 4.50 at 720p for a 10-second clip)
RUNWAYML_API_SECRET=

# Tripo modelling (global account). Not used while the frozen mesh is served from the cache.
TRIPO_API_KEY=

# LLM directors. To add one, add a backend in config.yaml and its key here.
ASTRA_API_KEY=
DEEPSEEK_API_KEY=
GLM_API_KEY=
KIMI_API_KEY=
QWEN_API_KEY=
GEMINI_API_KEY=

# Optional. The render step finds Blender and FFmpeg on PATH and in the usual install folders.
# Set these only if "python run.py check" reports one of them as missing.
# PROXYDIRECTOR_BLENDER=C:\Program Files\Blender Foundation\Blender 5.2\blender.exe
# PROXYDIRECTOR_FFMPEG=C:\ffmpeg\bin\ffmpeg.exe
